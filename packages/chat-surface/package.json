{
  "name": "@kokoro/chat-surface",
  "version": "0.1.0",
  "description": "Brand-neutral Kokoro Chat projection and assistant-ui adapter.",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=24.0.0" },
  "files": ["dist", "src"],
  "exports": { ".": { "types": "./src/index.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {
    "@assistant-ui/react": "0.14.28",
    "@kokoro/session-client": "workspace:*"
  },
  "peerDependencies": { "react": "^18 || ^19", "react-dom": "^18 || ^19" },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
