{
  "name": "@kokoro/chat-surface",
  "version": "0.1.0",
  "description": "Brand-neutral Kokoro Chat projection and assistant-ui adapter.",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=24.0.0" },
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./agui-presentation-dormant": {
      "types": "./src/runtime/agui-presentation-adapter.ts",
      "development": "./src/runtime/agui-presentation-adapter.ts",
      "import": "./dist/runtime/agui-presentation-adapter.js"
    },
    "./agui-compatibility-consumer": {
      "types": "./src/runtime/agui-compatibility-consumer.ts",
      "development": "./src/runtime/agui-compatibility-consumer.ts",
      "import": "./dist/runtime/agui-compatibility-consumer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "precompat:agui-consumer": "pnpm --filter @kokoro/session-client build && pnpm run build",
    "compat:agui-consumer": "node scripts/agui-compatibility-consumer.mjs --input",
    "prepack": "pnpm run build",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {
    "@assistant-ui/react": "0.14.28",
    "@kokoro/session-client": "workspace:*",
    "fast-json-stable-stringify": "2.1.0",
    "zod": "4.4.3"
  },
  "peerDependencies": { "react": "^18 || ^19", "react-dom": "^18 || ^19" },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
