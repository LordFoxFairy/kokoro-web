{
  "name": "@kokoro/memory-app",
  "version": "0.1.0",
  "description": "Brand-neutral saved-memory controls for independent Kokoro Sites.",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "engines": { "node": ">=24.0.0" },
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "prepack": "pnpm run build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {
    "@kokoro/site-client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
