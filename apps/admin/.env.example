# Next.js runtime and browser-safe Admin origin.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Local contract fixtures never connect to IAM. Production must use rpc.
ADMIN_DATA_SOURCE=fixture

# Server-only settings. Production AUTH_SECRET must contain at least 32 characters.
# IAM_RPC_URL is required whenever ADMIN_DATA_SOURCE=rpc.
AUTH_SECRET=
IAM_RPC_URL=http://127.0.0.1:8080

# Development-only Auth.js credentials. Keep disabled unless every field is set.
# AUTH_DEV_CREDENTIALS_ENABLED=true
# AUTH_DEV_ACCOUNT=admin
# AUTH_DEV_PASSWORD=local-only-secret
# AUTH_DEV_USER_ID=usr_ada
# AUTH_DEV_DISPLAY_NAME=Ada Chen
# AUTH_DEV_EMAIL=ada@example.test
# AUTH_DEV_CAPABILITIES=dashboard.read,users.read,organizations.read,sites.read,roles.read,sessions.read,audit.read,access.check
# AUTH_TRUST_HOST=true
