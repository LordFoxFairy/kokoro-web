# admin-web（Next.js BFF）env。复制为 .env.local 填真实值。lib/env.ts 启动即校验，缺项 fail-fast。

# Admin Web 本地 HttpOnly 会话加密密钥（至少 32 字节，务必轮换）
AUTH_SECRET=
KOKORO_ADMIN_RPC_URL=https://platform-admin:7443
KOKORO_ADMIN_TLS_KEY_FILE=/run/secrets/admin-web-client.key
KOKORO_ADMIN_TLS_CERT_FILE=/run/secrets/admin-web-client.crt
KOKORO_ADMIN_TLS_CA_FILE=/run/secrets/platform-admin-ca.crt
KOKORO_ADMIN_TLS_SERVER_NAME=platform-admin.internal
KOKORO_ADMIN_DELIVERY_KEY_RING_FILE=/run/secrets/admin-web-delivery-key-ring.json
KOKORO_ADMIN_WORKLOAD_IDENTITY_REF=spiffe://kokoro/web/admin
KOKORO_ADMIN_AUDIENCE=platform-admin
KOKORO_ADMIN_ENVIRONMENT=production
KOKORO_ADMIN_REGION=us-east-1
KOKORO_ADMIN_MANAGED_DEVICE_REF=admin-web:production
KOKORO_ADMIN_SITE_ID=site:default
KOKORO_ADMIN_RETURN_INTENT_REF=dashboard
KOKORO_ADMIN_STEP_UP_CALLBACK_REF=step-up
