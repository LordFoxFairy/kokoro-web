# Admin Web owns this runtime contract. Real values belong in ignored .env.local files.
NODE_ENV=development

# Auth.js public origin and server-only secret file.
AUTH_URL=http://localhost:3100
AUTH_SECRET_FILE=/absolute/path/to/admin-auth-secret
AUTH_SECURE_COOKIES=false

# Accepted kokoro-iam listener and the admin-web workload credential file.
KOKORO_IAM_BASE_URL=http://127.0.0.1:4100
KOKORO_IAM_ADMIN_WEB_TOKEN_FILE=/absolute/path/to/admin-web-workload-token

MAGIC_LINK_MAX_AGE=600
EMAIL_FROM=no-reply@kokoro.local
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=1025

# Optional authenticated SMTP pair. Set both or neither.
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD_FILE=
