# 每个 Web 项目只部署一个 Site。所有值均为示例，禁止直接用于生产。
KOKORO_SITE_PUBLIC_ORIGIN="https://site.example"
KOKORO_SITE_BRAND_NAME="Example AI"
AUTH_URL="https://site.example"
AUTH_SECRET="example-auth-secret-at-least-32-characters"

# Root 签发的不可变 Site deployment binding。
KOKORO_SITE_RUNTIME_ENVIRONMENT="production"
KOKORO_SITE_PROJECT_BINDING_REF="binding-example"
KOKORO_SITE_DEPLOYMENT_REF="deployment-example"
KOKORO_SITE_RELEASE_REF="release-example"
KOKORO_WEB_ARTIFACT_DIGEST="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
KOKORO_PLATFORM_WORKLOAD_CREDENTIAL="example-workload-credential-at-least-32-characters"
KOKORO_SESSION_CONTRACT_REVISION="session-browser-v3"
KOKORO_SITE_REGION="us-east"
KOKORO_PRODUCT_AUDIENCE="product-audience-example"

# 注册/卡密 launch-state cookie 加密密钥；可用逗号追加旧钥完成轮换。
KOKORO_WEB_SESSION_SECRET="example-launch-state-secret-at-least-32-characters"

# 注册的内部 HTTPS/mTLS transport；浏览器永远看不到这些地址与凭据。
KOKORO_SITE_RUNTIME_PLATFORM_ORIGIN="https://platform.internal.example"
KOKORO_SITE_RUNTIME_SESSION_ORIGIN="https://session.internal.example"
KOKORO_PLATFORM_CSRF_TOKEN="example-platform-csrf-token-at-least-32-characters"
KOKORO_BROWSER_CSRF_SECRET="example-browser-csrf-secret-at-least-32-characters"
KOKORO_SITE_RUNTIME_MTLS_CERT_FILE="/run/secrets/site-client.crt"
KOKORO_SITE_RUNTIME_MTLS_KEY_FILE="/run/secrets/site-client.key"
KOKORO_SITE_RUNTIME_MTLS_CA_FILE="/run/secrets/internal-ca.crt"

# BFF 对已注册内部服务的 deadline；100..60000 毫秒。
# KOKORO_SITE_UPSTREAM_TIMEOUT_MS="10000"
# 浏览器 mutation CSRF token 的有效期。
# KOKORO_BROWSER_CSRF_TTL_SECONDS="3600"

# SiteRelease 法律文档投影。唯一 typed source 同时派生 server-only termRef 和浏览器安全 label/href；为空或非法时注册 fail closed。
# KOKORO_SITE_REGISTRATION_LEGAL_DOCUMENTS='[{"termRef":"terms-2026","label":"Terms of Service","href":"https://example.com/terms"},{"termRef":"privacy-2026","label":"Privacy Policy","href":"https://example.com/privacy"}]'

# 生产部署使用 secure、httpOnly、host-only Site 会话 cookie。
NODE_ENV="production"
