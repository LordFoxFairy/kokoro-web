# kokoro-web 环境示例(Wave6 部署面补齐;全部为明显假值,勿用于生产)。
# 单源:src/lib/server/auth.ts、src/lib/server/site.ts、src/dev/preview-transport.ts;新增 env 必须同步本文件。
#
# 「platform 模式」四项齐备才算已接后端(缺任一 = 预览档纯前端,路由回 503/preview,登录闸放行):
#   KOKORO_WEB_SESSION_SECRET / KOKORO_USER_BASE_URL / KOKORO_SESSION_BASE_URL / KOKORO_SITE_ID。

# 信封会话 cookie 封缄密钥(httpOnly 信封,token 不出浏览器)。逗号分隔支持轮换:
# 新钥追加到**队首**,旧钥保留一个轮换窗口再删。生产必配。
KOKORO_WEB_SESSION_SECRET="example-session-secret-not-real"

# platform 后端基址(同源 `/api/*` BFF 代理目标)。
# user:magic-link 签发 / auth callback / team switch 换签。
KOKORO_USER_BASE_URL="http://kokoro-user:4211"
# session:对话流 SSE / 会话清单 / 计费窄读 / 成果 / 分享。
KOKORO_SESSION_BASE_URL="http://kokoro-session:3900"

# 站点单站点 id（仅显式 development fallback；其他环境不允许 auth 回退）。
KOKORO_SITE_ID="site-example"

# 能力中台 hub(self 面技能/MCP/凭据);缺省=连接/技能面板降级。可选。
# KOKORO_HUB_BASE_URL="http://kokoro-hub:4251"
# 套餐目录只读上游；缺省=套餐目录显式不可用。Web 不使用支付/provider secret。可选。
# KOKORO_PAYMENT_BASE_URL="http://kokoro-payment:4241"

# web-bff 出站内部服务凭据(TRUST-ROUTES,per-caller);缺省=直通(TRUST 合流前)。可选。
# KOKORO_INTERNAL_SECRET_WEB_BFF="example-internal-secret"

# User BFF 普通上游 deadline（连接/响应 headers；Auth/Site/Payment JSON 包含有界 body 解析）：
# 默认 10000，必须是 100..60000 的整数；非法配置会让服务装配失败，不会降级成 preview。
# KOKORO_WEB_UPSTREAM_TIMEOUT_MS="10000"

# 站点解析服务（SITE-REAL:host→site_id+品牌）。除显式 development fallback 外均必须可用。
# KOKORO_SITE_BASE_URL="http://kokoro-site:4261"
# Resolver 超时毫秒数：默认 1500，必须是 100..5000 的整数；非法配置显式失败。
# KOKORO_SITE_RESOLVE_TIMEOUT_MS="1500"
# 本地单站开发逃生阀：只有 NODE_ENV=development 且该值精确为 true 才回退 KOKORO_SITE_ID。
# test/preview/staging/production 即便设置也无效。
# KOKORO_SITE_ALLOW_DEV_FALLBACK="true"
# 显式 strict 会覆盖 development fallback，便于本地验证生产准入行为。
# KOKORO_SITE_STRICT="1"

# SiteRelease 法律文档投影。唯一 typed source 同时派生 server-only termRef 和浏览器安全 label/href；为空或非法时注册 fail closed。
# KOKORO_SITE_REGISTRATION_LEGAL_DOCUMENTS='[{"termRef":"terms-2026","label":"Terms of Service","href":"https://example.com/terms"},{"termRef":"privacy-2026","label":"Privacy Policy","href":"https://example.com/privacy"}]'

# dev 假流(不接后端也能走对话/HITL 主路径);仅本地开发,生产绝不开。可选。
# NEXT_PUBLIC_SESSION_PREVIEW="1"

# 运行环境:production 时启用 secure cookies 并关闭开发链接回显;通常由运行时注入,无需手配。
# NODE_ENV="development"
