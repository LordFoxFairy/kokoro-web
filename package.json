{
  "name": "@kokoro/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "Kokoro Web 子仓库：独立部署的用户工作台与 IAM 管理平台，以及受控共享包。",
  "scripts": {
    "dev": "pnpm --filter @kokoro/web-user dev",
    "build": "pnpm --filter @kokoro/web-user build",
    "start": "pnpm --filter @kokoro/web-user start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
